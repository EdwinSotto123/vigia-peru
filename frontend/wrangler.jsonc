// Réplica del frontend en Cloudflare Workers (OpenNext). Cloud Run sigue igual:
// infrastructure/deploy/frontend.sh. Variables y secretos: CLOUDFLARE.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vigia-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // /_next/image: sin este binding el worker devuelve la imagen original (el logo de 64 px
  // pesaría 140 KB en vez de 3). Cloudflare Images: 5000 transformaciones únicas al mes gratis.
  "images": { "binding": "IMAGES" },
  // Caché de páginas (ISR) compartida entre instancias: open-next.config.ts.
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "vigia-web-cache" }],
  "services": [
    // Revalidación ISR: el worker se pide a sí mismo la página vencida (open-next.config.ts).
    { "binding": "WORKER_SELF_REFERENCE", "service": "vigia-web" }
  ],
  // Subidas por IP en /api/upload (lib/limite-ip.ts): 10 cada 60 s. Fuera de Workers, en memoria.
  "ratelimits": [{ "name": "LIMITE_SUBIDAS", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } }],
  "vars": {
    "VIGIA_API_URL": "https://vigia-api.vigiaperu.workers.dev",
    "VIGIA_AGENT_URL": "https://agent-orchestrator-adk-753067078557.us-central1.run.app",
    "GOOGLE_CLOUD_PROJECT": "vivid-spot-480905-a4",
    "DOCS_BUCKET": "vigia-peru-documentos",
    "REPORTES_BUCKET": "vigia-peru-reportes",
    "GCS_BUCKET_PRIVADO": "vigia-peru-privado",
    "OECE_RELAY_URL": "https://oece-relay.vigia-peru.workers.dev"
  },
  "observability": { "enabled": true },
  // Junto a la API y los agentes (us-central1), como el frontend de Cloud Run: cada fetch del
  // servidor queda local y al usuario le llega una sola respuesta.
  "placement": { "region": "gcp:us-central1" },

  // Entorno DEV (docs/DEV.md): `bash infrastructure/deploy/dev.sh web` → vigia-web-dev, que habla con vigia-api-dev.
  // Entra por worker-dev.js (pide usuario y clave, noindex y una franja "DEV"), con su propia caché en R2.
  // Secretos (dev.sh secretos): ADMIN_TOKEN, ADMIN_SESSION_SECRET, ADMIN_EMAILS, TURNSTILE_SECRET_KEY, DEV_USUARIO, DEV_CLAVE.
  "env": {
    "dev": {
      "main": "worker-dev.js",
      "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
      "images": { "binding": "IMAGES" },
      "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "vigia-web-cache-dev" }],
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "vigia-web-dev" }],
      "ratelimits": [{ "name": "LIMITE_SUBIDAS", "namespace_id": "2002", "simple": { "limit": 10, "period": 60 } }],
      "vars": {
        "VIGIA_ENTORNO": "dev",
        "VIGIA_API_URL": "https://vigia-api-dev.vigiaperu.workers.dev",
        "VIGIA_AGENT_URL": "https://agent-orchestrator-adk-753067078557.us-central1.run.app",
        "OECE_RELAY_URL": "https://oece-relay.vigia-peru.workers.dev"
      }
    }
  }
}
