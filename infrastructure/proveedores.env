# Dónde corre cada componente de Vigía en PRODUCCIÓN. Lo lee infrastructure/deploy/desplegar.sh (docs/PROVEEDORES.md).
#
#   false (o vacío) = lo de hoy: Cloudflare Workers + AWS (Lambda, RDS).
#   true            = GCP: Cloud Run / Cloud Run Jobs, con el código y los scripts que siguen en el repo
#                     (infrastructure/deploy/gcp/, backend/cloud_functions, backend/mcp, backend/dispatcher…).
#
# GCP_USE vale para todos; GCP_USE_<COMPONENTE> manda sobre él. Una variable de entorno con el mismo nombre manda sobre
# este archivo (GCP_USE_API=true bash infrastructure/deploy/desplegar.sh api: sólo esa vez).

GCP_USE=false

GCP_USE_API=
GCP_USE_WEB=
GCP_USE_MCP=
GCP_USE_SCRAPERS=
GCP_USE_AGENTES=
GCP_USE_DISPATCHER=
