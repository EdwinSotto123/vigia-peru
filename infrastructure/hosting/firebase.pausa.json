{
  "hosting": {
    "site": "vigia-peru",
    "public": "public",
    "ignore": ["firebase.json", "firebase.pausa.json", "**/.*"],
    "redirects": [
      { "source": "/", "destination": "https://vigia.gobserva.cloud/", "type": 301 },
      { "source": "/v1/:ruta*", "destination": "https://vigia.gobserva.cloud/v1/:ruta", "type": 301 },
      { "source": "/:ruta*", "destination": "https://vigia.gobserva.cloud/:ruta", "type": 301 }
    ]
  }
}
