# Copiar a terraform.tfvars (gitignored). Mudarse de proyecto = cambiar estas dos líneas.
project_id     = "project-a974c6e5-0cdf-4b11-a86"
project_number = "753067078557"
region         = "us-central1"

# IP de la PC del batch nocturno (y de quien administre la base).
sql_authorized_networks = ["<tu-ip>/32"]

# Al mudarse, la clave de postgres se copia del origen: que Terraform no genere otra.
gestionar_password_sql = false

