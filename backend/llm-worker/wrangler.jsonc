// Vigía Perú · puerta de entrada a Cloudflare Workers AI con forma de API OpenAI (chat/completions).
// Los agentes (Cloud Run, LiteLLM) la usan cuando USAR_WORKERS_AI=1 (backend/agent/agents/_shared/models.py).
// Secretos: LLM_TOKEN (el agente lo manda como Bearer en WORKERS_AI_TOKEN) y, para el respaldo,
// RESPALDO_URL / RESPALDO_TOKEN / RESPALDO_MODELO (src/index.ts).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vigia-llm",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "vars": {
    "MODELO_DEFECTO": "@cf/deepseek-ai/deepseek-v4.1-flash-1017",
    "REASONING_EFFORT_DEFECTO": "low",
    "MAX_TOKENS_DEFECTO": "16000",
    // /nativo/v1/messages servido por Workers AI (NATIVO_EN_WORKERS_AI=1, o la cabecera x-vigia-nativo: workers):
    // el modelo pedido → el de Workers AI. Haiku → DeepSeek V4.1 flash; Sonnet y Opus → GLM 5.3 (2026-11-20).
    "NATIVO_MODELOS": "{\"claude-haiku-5-5\":\"@cf/deepseek-ai/deepseek-v4.1-flash-1017\",\"claude-sonnet-5-5\":\"@cf/zai-org/glm-5.3\",\"claude-opus-5-5\":\"@cf/zai-org/glm-5.3\",\"*\":\"@cf/deepseek-ai/deepseek-v4.1-flash-1017\"}",
    "NATIVO_MODELO_VISION": "@cf/deepseek-ai/deepseek-v4.1-flash-1017",
    // Si un modelo está en su tope por minuto (3021), el pedido pasa a sus hermanos (src/index.ts, correrConHermanos).
    "MODELOS_HERMANOS": "{\"@cf/deepseek-ai/deepseek-v4.1-flash-1017\":[\"@cf/google/gemma-4-26b-a4b-it\",\"@cf/qwen/qwen3.8-27b\"],\"@cf/google/gemma-4-26b-a4b-it\":[\"@cf/deepseek-ai/deepseek-v4.1-flash-1017\",\"@cf/qwen/qwen3.8-27b\"],\"@cf/zai-org/glm-5.3\":[\"@cf/deepseek-ai/deepseek-v4.1-flash-1017\"]}",
    // Retirados por Workers AI el 2026-11-20 (5028): quién responde por cada uno (src/index.ts, vigente).
    "MODELOS_RETIRADOS": "{\"@cf/zai-org/glm-5.3-flash\":\"@cf/deepseek-ai/deepseek-v4.1-flash-1017\",\"@cf/deepseek-ai/deepseek-v4-flash-0731\":\"@cf/deepseek-ai/deepseek-v4.1-flash-1017\",\"@cf/deepseek-ai/deepseek-v4-pro-0813\":\"@cf/zai-org/glm-5.3\",\"@cf/moonshotai/kimi-k2.6\":\"@cf/zai-org/glm-5.3\",\"@cf/moonshotai/kimi-k2.7-code\":\"@cf/zai-org/glm-5.3\",\"@cf/zai-org/glm-5.2\":\"@cf/zai-org/glm-5.3\",\"@cf/nvidia/nemotron-3-120b-a12b\":\"@cf/openai/gpt-oss-120b\",\"@cf/qwen/qwen3-30b-a3b-fp8\":\"@cf/zai-org/glm-4.7-flash\",\"@cf/deepseek-ai/deepseek-r1-distill-qwen-32b\":\"@cf/deepseek-ai/deepseek-v4.1-flash-1017\"}",
    // Sólo modelos abiertos de Workers AI (2026-11-10, pedido del usuario: «no usaremos Haiku ni nada de Claude»):
    // /nativo lo responde Workers AI y el respaldo queda apagado. Para volver: "0" en las dos.
    "NATIVO_EN_WORKERS_AI": "1",
    "RESPALDO_APAGADO": "1",
    // Modelos permitidos (lista blanca): evita que un token filtrado gaste en cualquier modelo.
    "MODELOS_PERMITIDOS": "@cf/deepseek-ai/deepseek-v4.1-flash-1017,@cf/zai-org/glm-5.3,@cf/google/gemma-4-26b-a4b-it,@cf/qwen/qwen3.8-27b,@cf/zai-org/glm-4.7-flash,@cf/openai/gpt-oss-120b,@cf/openai/gpt-oss-20b,@cf/thinkingmachines/inkling-2-small,@cf/meta/llama-3.3-70b-instruct-fp8-fast,@cf/zai-org/glm-5.3-flash,@cf/deepseek-ai/deepseek-v4-flash-0731,@cf/deepseek-ai/deepseek-v4-pro-0813,@cf/moonshotai/kimi-k2.6,@cf/moonshotai/kimi-k2.7-code,@cf/zai-org/glm-5.2,@cf/nvidia/nemotron-3-120b-a12b,@cf/qwen/qwen3-30b-a3b-fp8,@cf/deepseek-ai/deepseek-r1-distill-qwen-32b"
  }
}
