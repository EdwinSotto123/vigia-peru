// Vigía Perú · réplica del dispatcher en Cloudflare Workers (backend/dispatcher, el Cloud Run Job
// vigia-dispatcher, sigue igual). Ver README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vigia-dispatcher",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  // Junto a la base (RDS en us-east-2): ~17 ms por consulta (infrastructure/deploy/cloudflare/base.sh).
  "placement": { "region": "aws:us-east-2" },
  "minify": true,
  "upload_source_maps": true,

  // Rol vigia_dispatcher, pooling en modo transacción (PgBouncer). En `wrangler dev` la conexión sale
  // de CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "5616f9f3183941adb536f06fa2287bd3" }],

  // Un Workflow por hilo de corrida (src/workflow.ts).
  "workflows": [{ "name": "vigia-dispatcher-procesar", "binding": "PROCESAR", "class_name": "ProcesarContratos" }],

  // ENCENDIDO desde 2026-09-27: este es el dispatcher de producción. El job de Cloud Run quedó con su
  // Scheduler (vigia-dispatcher-run) PAUSADO, sin borrar. Para volver: "crons": [] y DISPATCHER_ACTIVO "0"
  // acá, y `gcloud scheduler jobs resume vigia-dispatcher-run --location us-central1`.
  "triggers": { "crons": ["*/5 * * * *"] },

  // Las de infrastructure/deploy/gcp/dispatcher.sh, sin las de conexión (PG*), que reemplaza Hyperdrive.
  // Secretos (wrangler secret put): AGENTE_TOKEN (Bearer de las Lambdas, SSM /vigia/agente/token),
  // DISPATCHER_TOKEN (endpoints manuales) y GCP_SA_KEY (sólo si se vuelve a Cloud Run).
  "vars": {
    // Apagado del 2026-10-14 al 11-04 (sin Cloud Run). ENCENDIDO el 2026-11-04 con las Lambdas de agentes de AWS
    // (una por red, imagen de backend/agent; infrastructure/deploy/aws/agentes.sh y el job deploy:agentes:prod):
    // el dispatcher les manda el Bearer AGENTE_TOKEN (secreto) en vez de un ID token de Google. Sólo analiza lo
    // que entra a `procesamientos` (contratos financiados y reanálisis del panel). Para apagar: "0" y deploy.
    "DISPATCHER_ACTIVO": "1",
    "AGENT_URL": "https://ntasl5bxctnf6l46pqnf2zsfrq0pbajw.lambda-url.us-east-2.on.aws",
    "AGENT_URL_BIENES": "https://ntasl5bxctnf6l46pqnf2zsfrq0pbajw.lambda-url.us-east-2.on.aws",
    "AGENT_URL_SERVICIOS": "https://rek7rzzvza7q7j6fn3cxxveqgm0dumuw.lambda-url.us-east-2.on.aws",
    "AGENT_URL_OBRAS": "https://uyp5wgfvicnfbzobcin6knx3340iujdc.lambda-url.us-east-2.on.aws",
    "AGENT_URL_CONSULTORIA": "https://v436ckrco2yia5r6jd63chpcge0vohif.lambda-url.us-east-2.on.aws",
    "AGENT_URL_OTROS": "https://4dbb4zoipvyjsq64noauxtufqq0pekyj.lambda-url.us-east-2.on.aws",
    "DISPATCHER_PARALLEL": "1",
    // Carriles a la vez ≈ DISPATCHER_MAX_MINUTES / 5 (cron cada 5 min). Con db-f1-micro (0,6 GB, 40 conexiones)
    // la base se quedó sin memoria con 5-7 carriles (29/09: memoria 100 %, análisis de 4 a 28 min).
    // Con db-custom-1-3840 (3,75 GB, 100 conexiones): ~5 carriles. El agente de bienes admite 6.
    "DISPATCHER_MAX_MINUTES": "25",
    "DISPATCHER_TASK_TIMEOUT_S": "7200",
    "DISPATCHER_ANALISIS_MAX_S": "3600",
    "DISPATCHER_STREAM_TIMEOUT": "1200",
    "DISPATCHER_GRACE_MINUTES": "20",
    "DISPATCHER_MAX_EVENTOS": "400",
    "DISPATCHER_PREFETCH_OCDS": "1",
    "DISPATCHER_REQUIERE_DOCS_GCS": "1",
    "DISPATCHER_TRAMO_S": "1200"
  }
}
