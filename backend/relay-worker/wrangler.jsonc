{
  // Reemplaza al relay de Lima (backend/relay/app.py, ese VPS ya no existe): misma API.
  // OECE y SEACE filtran por la IP de salida del punto de Cloudflare (ver src/index.ts): con esta
  // ubicación el Worker corre en Zúrich, donde responden 200, aunque lo llame Cloud Run desde EE.UU.
  // Medido 2026-09-30: Zúrich y Buenos Aires 200; Chicago, Dallas, Santiago, São Paulo y Fráncfort 403.
  "name": "vigia-relay",
  "placement": { "mode": "targeted", "region": "gcp:europe-west6" },
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "vars": {
    "GCS_BUCKET": "vigia-peru-documentos",
    "GCP_PROJECT": "vivid-spot-480905-a4",
    "MAX_BYTES": "62914560"
  }
  // Secretos (wrangler secret put): VIGIA_DL_TOKEN (el mismo LOCAL_DOWNLOADER_TOKEN de los agentes)
  // y GCP_SA_KEY (JSON de la cuenta vigia-downloader, con escritura en el bucket).
}
