// Vigía Perú · OCR abierto (Docling) en un Cloudflare Container. Secreto: OCR_TOKEN (SSM /vigia/ocr/token).
// El agente (tools/documentos/ocr_texto.py) y la lectura previa (backend/scripts/lectura_previa.py) lo llaman con OCR_URL.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vigia-ocr",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "LectorOcr",
      "image": "./contenedor/Dockerfile",
      "instance_type": "standard-4",
      // Tope de gasto: 12 instancias a la vez son ~US$ 4.7 por hora con todas ocupadas (el costo por página no cambia:
      // más instancias leen más páginas a la vez; una lectura previa de 20 contratos esperaba en cola con 4).
      "max_instances": 12
    }
  ],
  "durable_objects": { "bindings": [{ "name": "LECTOR", "class_name": "LectorOcr" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LectorOcr"] }],
  "vars": { "INSTANCIAS": "10" }
}
