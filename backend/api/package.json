{
  "name": "vigia-peru-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "test": "node --import tsx --test test/*.test.ts",
    "dev:worker": "npx wrangler dev --port 8802",
    "build:worker": "npx wrangler deploy --dry-run --outdir .wrangler-dist"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.22.0",
    "@hono/node-server": "^1.19.17",
    "firebase-admin": "^13.0.2",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=20"
  }
}
