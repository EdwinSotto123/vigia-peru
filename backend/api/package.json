{
  "name": "vigia-peru-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "test": "node --import tsx --test test/*.test.ts",
    "dev:worker": "npx wrangler dev --port 8802",
    "build:worker": "npx wrangler deploy --dry-run --outdir .wrangler-dist"
  },
  "dependencies": {
    "hono": "^4.6.13",
    "@hono/node-server": "^1.13.7",
    "pg": "^8.13.1",
    "@google-cloud/storage": "^7.14.0",
    "firebase-admin": "^13.0.2",
    "jose": "^6.2.12",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3"
  },
  "engines": { "node": ">=20" }
}
