// Réplica de la API en Cloudflare Workers (la de Cloud Run sigue igual). Ver CLOUDFLARE.md.
{
  "name": "vigia-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  // Junto a la base (RDS en us-east-2; el túnel entra por Chicago y Columbus): ~17 ms por consulta. Con la ubicación
  // vieja, gcp:us-central1 (Omaha, de cuando la base era Cloud SQL), eran ~177 ms (medido 2026-10-20).
  "placement": { "region": "aws:us-east-2" },
  // Asignación de aportes cada 10 min y las tareas de Gobserva a las 7:00 de Lima (src/worker.ts → scheduled); el
  // Scheduler de GCP quedó pausado.
  "triggers": { "crons": ["*/10 * * * *", "0 12 * * *"] },

  // Postgres detrás de Hyperdrive (reparte en modo transacción, como PgBouncer). Crear ambos con
  // el caché de consultas apagado (CLOUDFLARE.md). Local: CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_<BINDING>.
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "eb54ec0c9ff84a728b63478897d3bb73" },
    { "binding": "HYPERDRIVE_ADMIN", "id": "e59e43440e124a26936da5d311a9574f" }
  ],

  // Réplica R2 de documentos (la misma del Worker de scrapers): sirve los requerimientos de contratos menores
  // espejados desde prod6, cuyo WAF bloquea el egress de Cloudflare (routes/menores.ts).
  "r2_buckets": [
    { "binding": "DOCUMENTOS", "bucket_name": "vigia-peru-batch" },
    // Desde el 2026-11-06 (GCP sin facturación): comprobantes y el bucket viejo de documentos, leídos de R2.
    { "binding": "PRIVADO", "bucket_name": "vigia-peru-privado" },
    { "binding": "DOCUMENTOS_VIEJOS", "bucket_name": "vigia-peru-documentos" }
  ],

  // "Correr el dispatcher ahora" (lib/dispatcher.ts): un Worker no puede llamar por URL pública a otro
  // workers.dev de la misma cuenta (error 1042), así que va por service binding.
  // SEACE_ZRH: los reportes «ongei» del SEACE por Zúrich (backend/seace-zrh-worker), para el expediente SIAF a pedido.
  "services": [{ "binding": "DISPATCHER", "service": "vigia-dispatcher" }, { "binding": "SEACE_ZRH", "service": "vigia-seace-zrh" },
    // Chat del panel (routes/admin_chat.ts): el modelo y las herramientas del MCP v2.
    { "binding": "LLM", "service": "vigia-llm" }, { "binding": "MCP", "service": "vigia-mcp" }],

  // Por IP (lib/antibots.ts): escrituras públicas 10 por minuto y ruta (además del captcha, Turnstile); lecturas 120 por
  // minuto y búsquedas de texto 30. Lo que piden nuestros Workers (la web desde su servidor) no cuenta: WORKERS_PROPIOS.
  // Cuenta un Durable Object por clave (workers/limitador.ts): los bindings de Rate Limiting dejaban pasar casi todo con
  // el placement de arriba. La web usa la misma clase (frontend/wrangler.jsonc, script_name "vigia-api"). CHAT_INFORME:
  // cada informe del chat de investigación corre en el suyo y sigue aunque se cierre la pestaña (workers/chatInforme.ts).
  "durable_objects": { "bindings": [{ "name": "LIMITADOR", "class_name": "Limitador" }, { "name": "CHAT_INFORME", "class_name": "ChatInforme" }] },
  "migrations": [{ "tag": "limitador-v1", "new_sqlite_classes": ["Limitador"] }, { "tag": "chat-informe-v1", "new_sqlite_classes": ["ChatInforme"] }],

  // Workers AI: embeddings de @cf/baai/bge-m3 (1024 dimensiones) para el RAG de documentos (lib/rag.ts, migración 258):
  // POST /admin/rag/indexar, el cron de 10 min y la pregunta de GET /documentos/buscar. US$ 0,012 por millón de tokens.
  "ai": { "binding": "AI" },

  // Las mismas de infrastructure/deploy/gcp/api.sh, sin las de conexión (PG*), que reemplaza Hyperdrive.
  // Secretos (wrangler secret put): ADMIN_TOKEN, GCP_SA_KEY, DISPATCHER_TOKEN, TURNSTILE_SECRET_KEY (copia en
  // Secret Manager: turnstile-secret).
  "vars": {
    "FIREBASE_PROJECT_ID": "simplia-project",
    "GCS_PROJECT_ID": "vivid-spot-480905-a4",
    "GCS_BUCKET_DOCUMENTOS": "vigia-peru-documentos",
    "GCS_BUCKET_REPORTES": "vigia-peru-reportes",
    "ALLOWED_ORIGINS": "http://localhost:3000,https://vigia-peru-frontend-36169102688.us-central1.run.app,https://vigia-peru-frontend-oq3gq6a4ka-uc.a.run.app,https://vigia-web.vigiaperu.workers.dev,https://vigia.gobserva.cloud,https://empleo.gobserva.cloud,https://licitaciones.gobserva.cloud,https://obras.gobserva.cloud",
    // Zonas de nuestros Workers (cabecera CF-Worker): sus lecturas no cuentan en el límite por IP (lib/antibots.ts).
    "WORKERS_PROPIOS": "vigiaperu.workers.dev,gobserva.cloud",
    "MCP_INTERNO_URL": "https://mcp.gobserva.cloud/mcp",
    // Dónde se resuelve el captcha de la gente (lib/antibots.ts → verificarTurnstile): otro hostname queda en el registro;
    // con TURNSTILE_HOSTS_ESTRICTO "si", además se rechaza.
    "TURNSTILE_HOSTS": "vigia.gobserva.cloud,empleo.gobserva.cloud,licitaciones.gobserva.cloud,obras.gobserva.cloud",
    // Relay de descargas: el Worker vigia-relay (backend/relay-worker); el VPS de Lima ya no existe.
    "LOCAL_DOWNLOADER_URL": "https://vigia-relay.vigiaperu.workers.dev",
    // Sufijo de las URLs de los 4 agentes (lib/salud.ts): <servicio>-<número de proyecto>.<región>.run.app
    "AGENT_HOST_SUFFIX": "753067078557.us-central1.run.app",
    // "Correr el dispatcher ahora" (lib/dispatcher.ts): POST /ejecutar del Worker, con el secreto DISPATCHER_TOKEN.
    "DISPATCHER_URL": "https://vigia-dispatcher.vigiaperu.workers.dev",
    // Notificaciones de Gobserva (lib/webpush.ts): la llave pública VAPID; la privada es el secreto VAPID_PRIVATE_KEY
    // (copia en SSM /vigia/gobserva/vapid-privada). El correo va por la Lambda vigia-gobserva-correo (secretos
    // CORREO_URL y CORREO_TOKEN, infrastructure/aws/correo_gobserva).
    "VAPID_PUBLIC_KEY": "BLyYkP_h9_YFRVMIEoBpSAebunN_-kPsaqwQvZ5VnebZ_5sF80jlKd_q6vjhNStTYyKq1uqRWWK9azHqNPJtWHY"
  },

  // Entorno DEV (docs/DEV.md): `bash infrastructure/deploy/dev.sh api` → vigia-api-dev, contra la base vigia-db-dev
  // (roles dev_*, que no existen en producción). Sin cron, sin dispatcher y sin GCS: nada sale de DEV.
  // Secretos (dev.sh secretos): ADMIN_TOKEN, PRIVACIDAD_CLAVE y TURNSTILE_SECRET_KEY propios de DEV.
  "env": {
    "dev": {
      "triggers": { "crons": [] },
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "7baa210be4c346a2b74440fbbdb55826" },
        { "binding": "HYPERDRIVE_ADMIN", "id": "b89caaf04e304186b27f9cf4e43ffa2b" }
      ],
      "r2_buckets": [
        { "binding": "DOCUMENTOS", "bucket_name": "vigia-peru-batch-dev" },
        { "binding": "PRIVADO", "bucket_name": "vigia-peru-privado" },
        { "binding": "DOCUMENTOS_VIEJOS", "bucket_name": "vigia-peru-documentos" }
      ],
      "services": [{ "binding": "SEACE_ZRH", "service": "vigia-seace-zrh" }, { "binding": "LLM", "service": "vigia-llm" }, { "binding": "MCP", "service": "vigia-mcp-dev" }],
      "durable_objects": { "bindings": [{ "name": "LIMITADOR", "class_name": "Limitador" }, { "name": "CHAT_INFORME", "class_name": "ChatInforme" }] },
      "migrations": [{ "tag": "limitador-v1", "new_sqlite_classes": ["Limitador"] }, { "tag": "chat-informe-v1", "new_sqlite_classes": ["ChatInforme"] }],
      "ai": { "binding": "AI" },
      "vars": {
        "VIGIA_ENTORNO": "dev",
        "FIREBASE_PROJECT_ID": "simplia-project",
        "ALLOWED_ORIGINS": "http://localhost:3000,https://vigia-web-dev.vigiaperu.workers.dev,https://empleo-dev.gobserva.cloud,https://licitaciones-dev.gobserva.cloud,https://obras-dev.gobserva.cloud",
        // La web de DEV también entra por empleo-dev y licitaciones-dev.gobserva.cloud: sus subpedidos llegan con esa zona.
        "WORKERS_PROPIOS": "vigiaperu.workers.dev,gobserva.cloud",
        "MCP_INTERNO_URL": "https://vigia-mcp-dev.vigiaperu.workers.dev/mcp",
        "LOCAL_DOWNLOADER_URL": "https://vigia-relay.vigiaperu.workers.dev",
        "AGENT_HOST_SUFFIX": "753067078557.us-central1.run.app",
        "VAPID_PUBLIC_KEY": "BLyYkP_h9_YFRVMIEoBpSAebunN_-kPsaqwQvZ5VnebZ_5sF80jlKd_q6vjhNStTYyKq1uqRWWK9azHqNPJtWHY"
      }
    }
  }
}
