// Réplica de la API en Cloudflare Workers (la de Cloud Run sigue igual). Ver CLOUDFLARE.md.
{
  "name": "vigia-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  // Junto a la base (RDS en us-east-2; el túnel entra por Chicago y Columbus): ~17 ms por consulta. Con la ubicación
  // vieja, gcp:us-central1 (Omaha, de cuando la base era Cloud SQL), eran ~177 ms (medido 2026-10-20).
  "placement": { "region": "aws:us-east-2" },
  // Asignación de aportes cada 10 min (src/worker.ts → scheduled); el Scheduler de GCP quedó pausado.
  "triggers": { "crons": ["*/10 * * * *"] },

  // Postgres detrás de Hyperdrive (reparte en modo transacción, como PgBouncer). Crear ambos con
  // el caché de consultas apagado (CLOUDFLARE.md). Local: CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_<BINDING>.
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "eb54ec0c9ff84a728b63478897d3bb73" },
    { "binding": "HYPERDRIVE_ADMIN", "id": "e59e43440e124a26936da5d311a9574f" }
  ],

  // "Correr el dispatcher ahora" (lib/dispatcher.ts): un Worker no puede llamar por URL pública a otro
  // workers.dev de la misma cuenta (error 1042), así que va por service binding.
  "services": [{ "binding": "DISPATCHER", "service": "vigia-dispatcher" }],

  // Escrituras públicas: 10 por minuto por IP y ruta (lib/antibots.ts). Además del captcha (Turnstile).
  "ratelimits": [{ "name": "LIMITE_ESCRITURA", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],

  // Las mismas de infrastructure/deploy/api.sh, sin las de conexión (PG*), que reemplaza Hyperdrive.
  // Secretos (wrangler secret put): ADMIN_TOKEN, GCP_SA_KEY, DISPATCHER_TOKEN, TURNSTILE_SECRET_KEY (copia en
  // Secret Manager: turnstile-secret).
  "vars": {
    "FIREBASE_PROJECT_ID": "simplia-project",
    "GCS_PROJECT_ID": "vivid-spot-480905-a4",
    "GCS_BUCKET_DOCUMENTOS": "vigia-peru-documentos",
    "GCS_BUCKET_REPORTES": "vigia-peru-reportes",
    "ALLOWED_ORIGINS": "http://localhost:3000,https://vigia-peru-frontend-36169102688.us-central1.run.app,https://vigia-peru-frontend-oq3gq6a4ka-uc.a.run.app,https://vigia-web.vigiaperu.workers.dev",
    // Relay de descargas: el Worker vigia-relay (backend/relay-worker); el VPS de Lima ya no existe.
    "LOCAL_DOWNLOADER_URL": "https://vigia-relay.vigiaperu.workers.dev",
    // Sufijo de las URLs de los 4 agentes (lib/salud.ts): <servicio>-<número de proyecto>.<región>.run.app
    "AGENT_HOST_SUFFIX": "753067078557.us-central1.run.app",
    // "Correr el dispatcher ahora" (lib/dispatcher.ts): POST /ejecutar del Worker, con el secreto DISPATCHER_TOKEN.
    "DISPATCHER_URL": "https://vigia-dispatcher.vigiaperu.workers.dev"
  },

  // Entorno DEV (docs/DEV.md): `bash infrastructure/deploy/dev.sh api` → vigia-api-dev, contra la base vigia-db-dev
  // (roles dev_*, que no existen en producción). Sin cron, sin dispatcher y sin GCS: nada sale de DEV.
  // Secretos (dev.sh secretos): ADMIN_TOKEN, PRIVACIDAD_CLAVE y TURNSTILE_SECRET_KEY propios de DEV.
  "env": {
    "dev": {
      "triggers": { "crons": [] },
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "7baa210be4c346a2b74440fbbdb55826" },
        { "binding": "HYPERDRIVE_ADMIN", "id": "b89caaf04e304186b27f9cf4e43ffa2b" }
      ],
      "services": [],
      "ratelimits": [{ "name": "LIMITE_ESCRITURA", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }],
      "vars": {
        "VIGIA_ENTORNO": "dev",
        "FIREBASE_PROJECT_ID": "simplia-project",
        "ALLOWED_ORIGINS": "http://localhost:3000,https://vigia-web-dev.vigiaperu.workers.dev",
        "LOCAL_DOWNLOADER_URL": "https://vigia-relay.vigiaperu.workers.dev",
        "AGENT_HOST_SUFFIX": "753067078557.us-central1.run.app"
      }
    }
  }
}
