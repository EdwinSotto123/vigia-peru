# Imagen del agente para AWS Lambda (variante sin GCP). Es la misma imagen que Dockerfile más el Lambda Web
# Adapter, que traduce las invocaciones de la Function URL a HTTP contra functions-framework y deja pasar el
# streaming NDJSON (?stream=1) con InvokeMode=RESPONSE_STREAM.
#
#   docker build --platform linux/arm64 -f Dockerfile.lambda -t vigia-agente-lambda .
#
# Lambda sólo deja escribir en /tmp: HOME y las cachés de las librerías van ahí. Con HOME=/tmp libpq no encuentra
# ~/.postgresql/root.crt y PGSSLMODE=verify-full falla con "No such file": la CA de RDS va por PGSSLROOTCERT.

FROM public.ecr.aws/awsguru/aws-lambda-adapter:0.9.1 AS adaptador

FROM python:3.12-slim
COPY --from=adaptador /lambda-adapter /opt/extensions/lambda-adapter

RUN apt-get update && apt-get install -y --no-install-recommends \
        unar libarchive-tools antiword \
        && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
# Paquetes del motor de agentes por SDK (motores/motor_sdk): se pasan al construir, no viven en el repo.
#   docker build --build-arg PAQUETES_EXTRA="<paquete>==<versión>" …
# mcp queda en 1.x: ADK 1.19 importa `streamablehttp_client`, que mcp 2 ya no tiene, y el SDK acepta >=1.23.
ARG PAQUETES_EXTRA=""
RUN if [ -n "$PAQUETES_EXTRA" ]; then pip install --no-cache-dir $PAQUETES_EXTRA "mcp>=1.23,<2"; fi
COPY . .
RUN python -c "import google.adk, motores; print('adk', google.adk.__version__, '· motor', motores.nombre())"

ENV PORT=8080 \
    AWS_LWA_PORT=8080 \
    AWS_LWA_INVOKE_MODE=response_stream \
    AWS_LWA_READINESS_CHECK_PATH=/ \
    HOME=/tmp \
    PGSSLROOTCERT=/app/certs/rds-global-bundle.pem \
    XDG_CACHE_HOME=/tmp/.cache \
    HF_HOME=/tmp/hf \
    ANONYMIZED_TELEMETRY=False \
    LITELLM_LOCAL_MODEL_COST_MAP=True \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

CMD exec functions-framework --target=orchestrate --port=$PORT --host=0.0.0.0
