// Vigía Perú · servidor MCP (réplica en Workers de backend/mcp, hoy en Cloud Run como vigia-mcp).
// URL: https://vigia-mcp.vigiaperu.workers.dev/mcp
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vigia-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  // Junto a la base (RDS en us-east-2): ~17 ms por consulta (infrastructure/deploy/cloudflare/base.sh).
  "placement": { "region": "aws:us-east-2" },
  // Límite por IP (src/index.ts): el Durable Object de vigia-api; se despliega después de la API.
  "durable_objects": { "bindings": [{ "name": "LIMITADOR", "class_name": "Limitador", "script_name": "vigia-api" }] },
  "minify": true,
  "upload_source_maps": true,
  "hyperdrive": [
    {
      // Rol vigia_mcp, pooling en modo transacción (equivale al PgBouncer de Cloud Run).
      // En `wrangler dev` la conexión sale de CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
      "binding": "HYPERDRIVE",
      "id": "d25debb0dc09480797676f8edab64a75"
    }
  ]
}
